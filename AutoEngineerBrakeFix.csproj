<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AutoEngineerBrakeFix</AssemblyName>
    <RootNamespace>AutoEngineerBrakeFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>

    <!-- Change this (or pass /p:RailroaderDir=...) if your install lives elsewhere. -->
    <RailroaderDir Condition="'$(RailroaderDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Railroader</RailroaderDir>
    <ManagedDir>$(RailroaderDir)\Railroader_Data\Managed</ManagedDir>
    <!-- The game loads mods (asset packs) from Documents\Railroader\Mods. -->
    <ModsDir Condition="'$(ModsDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))\Railroader\Mods</ModsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets you build against .NET Framework 4.7.2 without the full targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The game does not ship Harmony; 0Harmony.dll goes into the pack beside the mod. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)\Railroader.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Railroader.Modding.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.*.dll" Private="false" />
    <!-- The settings window uses the game's panel builder and the Input System; its signatures mention types from these. -->
    <Reference Include="$(ManagedDir)\Unity.InputSystem.dll" Private="false" Condition="Exists('$(ManagedDir)\Unity.InputSystem.dll')" />
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" Condition="Exists('$(ManagedDir)\Unity.TextMeshPro.dll')" />
    <Reference Include="$(ManagedDir)\KeyValue.Runtime.dll" Private="false" Condition="Exists('$(ManagedDir)\KeyValue.Runtime.dll')" />
    <Reference Include="$(ManagedDir)\Core.dll" Private="false" Condition="Exists('$(ManagedDir)\Core.dll')" />
    <Reference Include="$(ManagedDir)\AssetPack.Common.dll" Private="false" Condition="Exists('$(ManagedDir)\AssetPack.Common.dll')" />
    <Reference Include="$(ManagedDir)\Map.Runtime.dll" Private="false" Condition="Exists('$(ManagedDir)\Map.Runtime.dll')" />
    <Reference Include="$(ManagedDir)\SimpleGraph.Runtime.dll" Private="false" Condition="Exists('$(ManagedDir)\SimpleGraph.Runtime.dll')" />
    <Reference Include="$(ManagedDir)\Unity.Burst.dll" Private="false" Condition="Exists('$(ManagedDir)\Unity.Burst.dll')" />
    <Reference Include="$(ManagedDir)\Unity.Mathematics.dll" Private="false" Condition="Exists('$(ManagedDir)\Unity.Mathematics.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackFiles Include="$(OutDir)AutoEngineerBrakeFix.dll;$(OutDir)0Harmony.dll;$(MSBuildProjectDirectory)\Info.json" />
  </ItemGroup>

  <!-- Copies the built mod straight into the game's Mods folder. Disable with /p:DeployToGame=false -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' != 'false'">
    <Copy SourceFiles="@(PackFiles)" DestinationFolder="$(ModsDir)\AutoEngineerBrakeFix" />
    <Message Importance="high" Text="Deployed AutoEngineerBrakeFix to $(ModsDir)\AutoEngineerBrakeFix" />
  </Target>

  <!-- dotnet build -c Release /p:Package=true  ->  dist\AutoEngineerBrakeFix-<version>.zip containing AutoEngineerBrakeFix\{dll,0Harmony.dll,Info.json} -->
  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Package)' == 'true'">
    <PropertyGroup>
      <StageDir>$(MSBuildProjectDirectory)\dist\stage\AutoEngineerBrakeFix</StageDir>
      <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">2.5.5</ReleaseVersion>
    </PropertyGroup>
    <RemoveDir Directories="$(MSBuildProjectDirectory)\dist" />
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="@(PackFiles)" DestinationFolder="$(StageDir)" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\dist\stage" DestinationFile="$(MSBuildProjectDirectory)\dist\AutoEngineerBrakeFix-$(ReleaseVersion).zip" />
    <Message Importance="high" Text="Packaged dist\AutoEngineerBrakeFix-$(ReleaseVersion).zip" />
  </Target>

</Project>
